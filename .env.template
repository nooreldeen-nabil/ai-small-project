# ============================================================================
# LLM Agentic AI MVP - Environment Configuration Template
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (git ignored)
# 2. Fill in your actual values
# 3. Never commit .env to git (contains secrets)
# ============================================================================

# LLM Provider Selection
LLM_PROVIDER=GEMINI

# Google Gemini API Configuration (FREE!)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your-claude-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# Oracle Database Configuration
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USERNAME=ai_user
ORACLE_PASSWORD=ai_password_2024
ORACLE_SCHEMA=AI_SCHEMA

# Camunda Configuration
CAMUNDA_ZEEBE_GATEWAY=localhost:26500
CAMUNDA_ZEEBE_REST=http://localhost:8088
CAMUNDA_OPERATE_URL=http://localhost:8081
CAMUNDA_TASKLIST_URL=http://localhost:8082
CAMUNDA_OPTIMIZE_URL=http://localhost:8083

# Spring Boot Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Vector Database Configuration
VECTOR_DIMENSION=1536
VECTOR_DISTANCE_METRIC=COSINE

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG

# ============================================================================
# Camunda Platform 8 Docker Compose Configuration
# ============================================================================
# These variables are used by docker-compose-camunda.yml

## Camunda Image Versions ##
CAMUNDA_CONNECTORS_VERSION=8.7.13
CAMUNDA_ZEEBE_VERSION=8.7.21
CAMUNDA_IDENTITY_VERSION=8.7.11
CAMUNDA_OPERATE_VERSION=8.7.21
CAMUNDA_TASKLIST_VERSION=8.7.21
CAMUNDA_OPTIMIZE_VERSION=8.7.14
CAMUNDA_WEB_MODELER_VERSION=8.7.14

## Supporting Services Versions ##
ELASTIC_VERSION=8.17.10
KEYCLOAK_SERVER_VERSION=26.3.2
MAILPIT_VERSION=v1.21.8
POSTGRES_VERSION=14.5-alpine

## Camunda Platform Configuration ##
HOST=localhost
KEYCLOAK_HOST=localhost

# Authentication mode: 'none' for development, 'identity' for production
ZEEBE_AUTHENTICATION_MODE=none
ZEEBE_CLIENT_ID=zeebe
ZEEBE_CLIENT_SECRET=zecret

# Authorization and Multi-tenancy
RESOURCE_AUTHORIZATIONS_ENABLED=false
MULTI_TENANCY_ENABLED=false

# REST Query API
CAMUNDA_REST_QUERY_ENABLED=true
